generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  pets      Pet[]
}

model Pet {
  id          String    @id @default(cuid())
  userId      String
  name        String
  species     String
  breed       String?
  dateOfBirth DateTime?
  createdAt   DateTime  @default(now())

  user User @relation(fields: [userId], references: [id])
}
